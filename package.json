{
  "name": "hexbase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "hexbase.dev — inspect the bytes. Developer tools for binary analysis, data formatting, timestamps, encodings, and network packets.",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "watch": "vite build --watch",
    "build": "node scripts/make-format-pages.mjs && vite build",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "types": "wrangler types",
    "db:local": "wrangler d1 execute hexbase-db --local --file ./schema.sql",
    "db:remote": "wrangler d1 execute hexbase-db --remote --file ./schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
